{
  "apiURL": "${URL}",
  "servicetype": "HTTP",
  "methodType": "POST",
  "contentType": "application/json",
  "headers": {
    "Content-Type": "application/json",
    "Accept": "*/*",
    "Apikey": "Y2FsZ2xpbnRlcmZhY2Vlc2I=",
    "companyId": "{REQUEST~apiRequest.requestObj.branchCode}"
  },
  "requestDef": {
    "header": {
      "uniqueIdentifier":"${REQUEST~apiRequest.requestObj.uniqueIdentifier}",
	  "companyId": "${REQUEST~apiRequest.requestObj.branchCode}"

    },
    "body": {
      "customerDetails~@JSONARRAY@": [
        {
          "customerId":"${REQUEST~apiRequest.requestObj.customerDetails[].customerId}",
          "cusCollectionAmt":"${REQUEST~apiRequest.requestObj.customerDetails[].cusCollectionAmt}",
		  "totalUpiCollection":"${REQUEST~apiRequest.requestObj.customerDetails[].totalUpiCollection}",
          "collFlag":"${REQUEST~apiRequest.requestObj.customerDetails[].cusFlag}",
          "upiFlag":"${REQUEST~apiRequest.requestObj.customerDetails[].upiFlag}",
		  "loanDetails~@JSONARRAY@":"${REQUEST~apiRequest.requestObj.customerDetails[].loanDetails}"
        }
      ]
    }
  },
  "responseDef": "",
  "logging": {
    "logRequired": "Y",
    "logType": "BOTH",
    "externalAPILogRequired": "Y",
    "externalAPILogType": "BOTH"
  }
}
